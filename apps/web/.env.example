# ============================================================================
# Happy Vibecode — Environment Variables Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
# Run `happy-vibecode setup` for an interactive wizard.
# ============================================================================

# ---- Authentication — GitHub OAuth App ----
# Create at: https://github.com/settings/applications/new
#   Homepage URL:    https://your-domain.workers.dev
#   Callback URL:    https://your-domain.workers.dev/api/auth/callback/github
AUTH_GITHUB_ID=your-github-oauth-app-client-id
AUTH_GITHUB_SECRET=your-github-oauth-app-client-secret

# ---- Better Auth ----
# Generate secret with:  openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-32-char-random-secret
# Your deployed Worker URL (use http://localhost:8787 for local dev)
BETTER_AUTH_URL=https://happy-vibecode.your-domain.workers.dev

# ---- Cloudflare ----
# Account ID: https://dash.cloudflare.com/profile  (32 hex chars)
CLOUDFLARE_ACCOUNT_ID=your-32-hex-account-id
# API Token: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Workers Scripts (edit), D1 (edit), KV Storage (edit), Workers Routes (edit)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ---- Stripe (optional — leave blank for local dev) ----
# Keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_with_real_key
# Webhook secret at: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_secret
# Price ID at: https://dashboard.stripe.com/products
STRIPE_PRICE_ID=price_replace_with_real_price_id

# ---- Cloudflare Turnstile (optional CAPTCHA) ----
# Dashboard: https://dash.cloudflare.com/turnstile
TURNSTILE_SECRET_KEY=0x4AAAA_replace_with_real_key
