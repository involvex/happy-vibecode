{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "happy-vibecode",
	"account_id": "d4e0f1c1c830642168db2f4ea3aece58",
	"compatibility_date": "2026-02-12",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./worker/index.ts",
	"preview_urls": true,
	"assets": {
		"directory": "./public",
		"not_found_handling": "none",
		// Expose static assets to the Worker via env.ASSETS so the image
		// optimization handler can fetch source images programmatically.
		"binding": "ASSETS",
		"run_worker_first": ["/agents/*"],
	},
	// Cloudflare Images binding for next/image optimization.
	// Enables resize, format negotiation (AVIF/WebP), and quality transforms
	// at the edge. No user setup needed — wrangler creates the binding automatically.
	"images": {
		"binding": "IMAGES",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "happy-vibecode-db",
			"database_id": "2c49dfdf-ec4a-408c-b101-4793a1405cc3", // replace with real D1 database ID after `wrangler d1 create happy-vibecode`
			"migrations_dir": "../../packages/db/drizzle",
		},
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "ba4e9794ba604de08ce3ceaf4ac3719f", // replace with real KV namespace ID after `wrangler kv namespace create happy-vibecode-kv`
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "BridgeAgent",
				"name": "BridgeAgent",
			},
		],
	},
	"migrations": [
		{
			"new_classes": ["BridgeAgent"],
			"tag": "v1",
		},
	],
}
