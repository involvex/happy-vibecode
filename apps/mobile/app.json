{
	"expo": {
		"name": "Happy Vibecode",
		"slug": "happy-vibecode",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"owner": "involvex",
		"splash": {
			"image": "./assets/icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#0f0f0f"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.happyvibecode.app"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/icon.png",
				"backgroundColor": "#0f0f0f"
			},
			"package": "com.happyvibecode.app"
		},
		"web": {
			"bundler": "metro",
			"output": "static"
		},
		"plugins": ["expo-router", "expo-secure-store", "expo-font"],
		"experiments": {
			"typedRoutes": true
		},
		"scheme": "happy-vibecode"
	}
}
