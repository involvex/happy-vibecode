{
	"expo": {
		"name": "Happy Vibecode",
		"slug": "happy-vibecode",
		"version": "0.0.1",
		"orientation": "portrait",
		"icon": "assets/icon.PNG",
		"userInterfaceStyle": "automatic",
		"githubUrl": "https://github.com/involvex/happy-vibecode.git",
		"owner": "involvex",
		"splash": {
			"image": "assets/icon512x512.png",
			"resizeMode": "contain",
			"backgroundColor": "#0f0f0f"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.happyvibecode.app"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "assets/icon512x512.png",
				"backgroundColor": "#0f0f0f"
			},
			"icon": "assets/icon512x512.png",
			"versionCode": 1,
			"userInterfaceStyle": "automatic",
			"package": "com.happyvibecode.app"
		},
		"web": {
			"bundler": "metro",
			"output": "static"
		},
		"plugins": ["expo-router", "expo-secure-store", "expo-font"],
		"experiments": {
			"typedRoutes": true
		},
		"scheme": "happy-vibecode",
		"extra": {
			"router": {},
			"eas": {
				"projectId": "f7854379-1f74-4e83-9f30-ade960bbc420"
			}
		}
	}
}
