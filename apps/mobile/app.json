{
	"expo": {
		"name": "Happy Vibecode",
		"slug": "happy-vibecode",
		"version": "0.0.11",
		"orientation": "portrait",
		"icon": "assets/icon512x512.png",
		"userInterfaceStyle": "automatic",
		"githubUrl": "https://github.com/involvex/happy-vibecode.git",
		"platforms": ["android", "web"],
		"owner": "involvex",
		"splash": {
			"image": "assets/icon512x512.png",
			"resizeMode": "contain",
			"backgroundColor": "#0f0f0f"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.happyvibecode.app",
			"buildNumber": "NaN",
			"runtimeVersion": {
				"policy": "appVersion"
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "assets/icon512x512.png",
				"backgroundColor": "#0f0f0f"
			},
			"icon": "assets/icon512x512.png",
			"versionCode": 11,
			"userInterfaceStyle": "automatic",
			"package": "com.happyvibecode.app",
			"googleServicesFile": "./google-services.json",
			"permissions": [
				"android.permission.USE_BIOMETRIC",
				"android.permission.USE_FINGERPRINT",
				"android.permission.USE_BIOMETRIC",
				"android.permission.USE_FINGERPRINT"
			],
			"runtimeVersion": "1.0.0"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "assets/icon512x512.png"
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			"expo-font",
			"expo-dev-client",
			"expo-web-browser",
			[
				"expo-notifications",
				{
					"icon": "assets/icon512x512.png",
					"color": "#7c3aed",
					"defaultChannel": "default",
					"projectId": "f7854379-1f74-4e83-9f30-ade960bbc420"
				}
			],
			"expo-local-authentication"
		],
		"experiments": {
			"typedRoutes": true
		},
		"scheme": "happy-vibecode",
		"extra": {
			"router": {},
			"eas": {
				"projectId": "f7854379-1f74-4e83-9f30-ade960bbc420"
			}
		},
		"updates": {
			"url": "https://u.expo.dev/f7854379-1f74-4e83-9f30-ade960bbc420"
		}
	}
}
