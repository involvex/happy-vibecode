{
	"react-native-tools.projectRoot": "apps/mobile",
	"search.exclude": {
		"**/node_modules": true,
		"**/bower_components": true,
		"**/*.code-search": true,
		"**/.dart_tool": true,
		"**/.claude/skills": true,
		"**/.agent/skills": true
	},
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"**/flutter/ephemeral": true,
		"**/Flutter/ephemeral": true,
		"**/.symlinks": true,
		"**/.plugin_symlinks": true,
		"**/.mcs": true,
		"**/.claude/skills": true,
		"**/.agent/skills": true
	},
	"cSpell.words": ["happyvibecode"],
	"oxc.enable.oxlint": true,
	"oxc.tsConfigPath": "apps/web",
	"appmod.enableVerboseLogging": false,
	"appmod.experimental.enableExperimentalTasks": false,
	"kilo-code.new.autocomplete.enableAutoTrigger": false,
	"prettier.configPath": "node_modules/@involvex/prettier-config/index.json",
	"js/ts.preferences.organizeImports": {"locale": "true"}
}
