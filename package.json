{
	"name": "happy-vibecode-repo",
	"version": "0.0.6",
	"description": "Monorepo for Happy Vibecode. Lets you vibe anytime anywhere",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/involvex/happy-vibecode.git"
	},
	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/involvex"
		},
		{
			"type": "others",
			"url": "https://paypal.me/involvex"
		}
	],
	"author": {
		"name": "involvex"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"app:version:patch": "bun run -F @happy-vibecode/mobile version:patch",
		"prebuild": "bun run format && bun run lint:fix && bun run typecheck",
		"build": "turbo run build",
		"build:cli": "bun run -F @happy-vibecode/cli build",
		"build:web": "bun run -F @happy-vibecode/web build",
		"changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s -r 0",
		"clean": "del-cli node_modules apps/*/node_modules packages/*/node_modules packages/cli/dist apps/web/dist",
		"deploy:web": "bun run -F @happy-vibecode/web deploy",
		"dev": "turbo run dev",
		"dev:web": "bun run -F @happy-vibecode/web dev",
		"format": "prettier --write .",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"release": "powershell -F scripts/release.ps1",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck"
	},
	"prettier": "@involvex/prettier-config",
	"overrides": {
		"drizzle-orm": "0.44.7"
	},
	"dependencies": {
		"@tsconfig/bun": "^1.0.10",
		"@types/bun": "^1.3.11",
		"turbo": "^2.9.3"
	},
	"devDependencies": {
		"@involvex/prettier-config": "^0.0.4",
		"conventional-changelog": "^7.2.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"conventional-changelog-preset-loader": "^5.0.0",
		"del-cli": "^7.0.0",
		"prettier": "^3.8.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-packagejson": "^3.0.2",
		"prettier-plugin-sort-imports": "^1.8.11"
	},
	"peerDependencies": {
		"typescript": "5.9.3"
	},
	"packageManager": "bun@1.3.10",
	"sponsor": {
		"url": "https://github.com/sponsors/involvex"
	}
}
