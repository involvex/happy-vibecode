{
	"name": "@happy-vibecode/cli",
	"version": "0.1.2",
	"description": "Happy Vibecode CLI — remote control for local AI agents",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/involvex/happy-vibecode.git"
	},
	"author": {
		"name": "involvex"
	},
	"type": "module",
	"bin": {
		"happy-vibecode": "src/index.ts",
		"vibe": "src/index.ts"
	},
	"files": [
		"dist/index.js",
		"src/index.ts",
		"Readme.md",
		"../../CHANGELOG.md"
	],
	"scripts": {
		"build": "bun build ./src/index.ts --outfile dist/index.js --target bun",
		"dev": "bun run --watch src/index.ts",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"prepublishOnly": "bun run lint:fix && bun run typecheck && bun run build",
		"start": "bun run ./src/index.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@clack/prompts": "^1.2.0",
		"@happy-vibecode/shared": "workspace:*",
		"@opencode-ai/sdk": "1.14.29",
		"chalk": "^5.3.0",
		"cli-highlight": "^2.1.11",
		"commander": "^14.0.0",
		"node-pty": "^1.1.0",
		"ora": "^6.3.1",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.3.13",
		"@types/node": "^25.6.0",
		"@types/ws": "^8.5.14",
		"eslint": "^10.2.1",
		"globals": "^17.5.0",
		"jiti": "latest",
		"typescript": "^5",
		"typescript-eslint": "^8.58.2"
	}
}
